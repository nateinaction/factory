#!/usr/bin/env bash
# The github_app role installs each App's credentials under its own agent role's
# directory, with the stated owner and modes, and refuses an App for no agent role.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

TEST_USER="$(id -un)"
TEST_GROUP="$(id -gn)"
export ANSIBLE_CONFIG="$root/ansible.cfg" TEST_USER TEST_GROUP TEST_APP_DIR="$work/etc/github-app" TEST_KEY_DIR="$work/keys"
mkdir -p "$TEST_KEY_DIR"
echo "implementer-key" >"$TEST_KEY_DIR/implementer.pem"
echo "reviewer-key" >"$TEST_KEY_DIR/reviewer.pem"

failures=0
vars=(-e "dagu_user=$TEST_USER" -e "github_app_group=$TEST_GROUP" -e "github_app_dir=$TEST_APP_DIR")
check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "ok   $name"; else
    echo "FAIL $name" >&2
    failures=$((failures + 1))
  fi
}

if ! ansible-playbook "$root/tests/github_app.yml" "${vars[@]}" >"$work/log" 2>&1; then
  cat "$work/log" >&2
  echo "FAIL role playbook" >&2
  exit 1
fi

# mode <path> <expected>: the octal permission bits.
mode() { [ "$(python3 -c 'import os,sys; print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$1")" = "$2" ]; }
# owner <path>: owned by the dagu user.
owner() { [ "$(python3 -c 'import os,pwd,sys; print(pwd.getpwuid(os.stat(sys.argv[1]).st_uid).pw_name)' "$1")" = "$TEST_USER" ]; }

check "base directory is 0700" mode "$TEST_APP_DIR" 700
for pair in implementer:111:implementer-key reviewer:222:reviewer-key; do
  app="${pair%%:*}"
  rest="${pair#*:}"
  id="${rest%%:*}"
  key="${rest#*:}"
  check "$app directory mode" mode "$TEST_APP_DIR/$app" 700
  check "$app directory owner" owner "$TEST_APP_DIR/$app"
  for f in app-id private-key.pem; do
    check "$app/$f is 0600" mode "$TEST_APP_DIR/$app/$f" 600
    check "$app/$f owner" owner "$TEST_APP_DIR/$app/$f"
  done
  check "$app/app-id holds its own id" grep -Fxq "$id" "$TEST_APP_DIR/$app/app-id"
  check "$app/private-key.pem holds its own key" grep -Fxq "$key" "$TEST_APP_DIR/$app/private-key.pem"
  check "$app's key is not in another App's directory" bash -c '! grep -rFq --exclude-dir="$3" -- "$1" "$2"' _ "$key" "$TEST_APP_DIR" "$app"
done

# An App for no agent role fails the play before anything is written.
rm -rf "$TEST_APP_DIR"
if ansible-playbook "$root/tests/github_app.yml" "${vars[@]}" -e '{"github_apps":{"janitor":{"app_id":"1","private_key_file":"/dev/null"}}}' >"$work/log2" 2>&1; then
  echo "FAIL an App for an unknown agent role was accepted" >&2
  failures=$((failures + 1))
else
  echo "ok   an App for an unknown agent role fails the play"
fi
check "nothing installed for the rejected App" bash -c '[ ! -e "$1/janitor" ]' _ "$TEST_APP_DIR"

[ "$failures" -eq 0 ]
