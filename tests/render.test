#!/usr/bin/env bash
# What the agent role's templates render to: the factory-* DAGs call foreman
# start, no finances-agent name survives, and sudoers allows only `foreman run *`.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
export RENDER_DIR="$out" ANSIBLE_CONFIG="$root/ansible.cfg"

if ! ansible-playbook "$root/tests/render.yml" >"$out/.log" 2>&1; then
  cat "$out/.log" >&2
  echo "FAIL render playbook" >&2
  exit 1
fi

failures=0
# check <name> <command...>: passes when the command succeeds.
check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "ok   $name"; else echo "FAIL $name" >&2; failures=$((failures + 1)); fi
}

for role in planner researcher implementer reviewer curator; do
  dag="$out/factory-$role.yaml"
  check "$role DAG calls foreman start with its role" \
    grep -Fq "/usr/local/bin/foreman start $role \${params.REPO} \${params.ISSUE} \${params.TRACEPARENT}" "$dag"
  check "$role DAG declares REPO" grep -Eq 'name: REPO' "$dag"
  check "$role DAG declares ISSUE" grep -Eq 'name: ISSUE' "$dag"
  check "$role DAG declares TRACEPARENT" grep -Eq 'name: TRACEPARENT' "$dag"
  check "$role DAG has its own queue" grep -Fq "queue: factory-$role" "$dag"
  check "$role DAG selects a host that takes the role" grep -Fq "$role: \"true\"" "$dag"
  check "$role queue rendered for dagu" grep -Fq "name: factory-$role" "$out/dagu-config.yaml"
done

check "the poll DAG runs foreman poll" grep -Fq '/usr/local/bin/foreman poll' "$out/factory-poll.yaml"
check "the poll DAG runs one poll at a time" grep -Fq 'max_active_runs: 1' "$out/factory-poll.yaml"
check "an unset host role list takes every agent role" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); roles={"planner","researcher","implementer","reviewer","curator"}; labels=d["worker_labels"].split(","); assert {l.split("=")[0] for l in labels[1:]} == roles, labels' \
  "$out/scheduling.json"
check "no agent role is unhosted when every worker takes all" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert d["unhosted_roles"] == [], d' "$out/scheduling.json"
check "the per-host run cap defaults to one" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert int(d["run_cap"]) == 1, d; assert int(d["queue_capacity"]) == 1, d' \
  "$out/scheduling.json"
check "a worker runs at most the run cap at once" grep -Fq -- '--worker.max-active-runs 1' "$out/dagu-worker.service"
check "a worker labelled every agent role" grep -Fq -- '--worker.labels runner=agent,planner=true,researcher=true,implementer=true,reviewer=true,curator=true' "$out/dagu-worker.service"
check "dagu exports foreman's OTLP endpoint to its steps" bash -c "
  grep -Fxq 'Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318' '$out/dagu-worker.service' &&
  grep -Fxq 'Environment=OTEL_SERVICE_NAME=foreman' '$out/dagu-worker.service'"
check "foreman's config names the unhosted roles" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert "unhosted_roles" in d, d' "$out/config.json"
check "each agent role's run capacity is the run cap times its hosts" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); want={"planner":1,"researcher":1,"implementer":1,"reviewer":1,"curator":1}; assert d["role_capacity"] == want, d' \
  "$out/scheduling.json"
check "foreman's config gives each agent role its run capacity" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); want={"planner":1,"researcher":1,"implementer":1,"reviewer":1,"curator":1}; assert d["role_capacity"] == want, d' \
  "$out/config.json"
check "the server's config points status at Tempo" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert d["telemetry_url"] == "http://127.0.0.1:3200", d' "$out/config.json"
check "a worker's config reads no remote backend" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert d["telemetry_url"] == "", d' "$out/config-worker.json"
check "no old name in any rendered file" bash -c '! grep -rq finances-agent "$1"' _ "$out"

check "sudoers permits foreman run *" grep -Fq '/usr/local/bin/foreman run *' "$out/dagu-agent.sudoers"
# Exactly one command on the NOPASSWD line, and it is foreman run *.
check "sudoers has exactly one permitted command" bash -c \
  'grep -E "NOPASSWD:" "$1" | sed "s/.*NOPASSWD: *//" | grep -Fxq "/usr/local/bin/foreman run *"' _ "$out/dagu-agent.sudoers"
# The agent never inherits the factory's configuration through sudo: no FACTORY_* variable is kept.
check "sudoers keeps no FACTORY_ variable" bash -c '! grep -Ev "^\s*#" "$1" | grep -Eq "FACTORY_"' _ "$out/dagu-agent.sudoers"
# The check above is not vacuous: env_keep is present, and names the run id, the trace context and the
# telemetry export variables only.
check "sudoers keeps only the run id, trace context and OTEL export variables" bash -c \
  'kept="$(grep -E "env_keep" "$1" | sed "s/.*env_keep *+\?= *//" | tr -d "\"" | tr " " "\n" | sort -u)"; [ "$kept" = "$(printf "DAG_RUN_ID\nOTEL_EXPORTER_OTLP_ENDPOINT\nOTEL_SERVICE_NAME\nTRACEPARENT")" ]' _ "$out/dagu-agent.sudoers"
if command -v visudo >/dev/null 2>&1; then
  check "sudoers passes visudo" visudo -cf "$out/dagu-agent.sudoers"
fi

# A host that lists its roles takes only those: the labels select only them, and every other role is
# reported as unhosted so the poll warns and leaves its issues queued.
narrow="$out/narrow"
mkdir -p "$narrow"
if ! RENDER_DIR="$narrow" RENDER_HOST_ROLES=reviewer RENDER_RUN_CAP=2 ansible-playbook "$root/tests/render.yml" >"$narrow/.log" 2>&1; then
  cat "$narrow/.log" >&2
  echo "FAIL narrow render playbook" >&2
  failures=$((failures + 1))
fi

check "a host takes only the roles it lists" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); labels=d["worker_labels"].split(","); assert {l.split("=")[0] for l in labels[1:]} == {"reviewer"}, labels' \
  "$narrow/scheduling.json"
check "an agent role no host takes is named" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert set(d["unhosted_roles"]) == {"planner","researcher","implementer","curator"}, d' \
  "$narrow/scheduling.json"
check "foreman's config names the roles no host takes" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert set(d["unhosted_roles"]) == {"planner","researcher","implementer","curator"}, d' \
  "$narrow/config.json"
check "a raised run cap lets a worker run two at once" grep -Fq -- '--worker.max-active-runs 2' "$narrow/dagu-worker.service"
check "a raised run cap raises the queue capacity" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); assert int(d["run_cap"]) == 2, d; assert int(d["queue_capacity"]) == 2, d' \
  "$narrow/scheduling.json"
check "a raised run cap raises only the hosted role's capacity" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); want={"planner":0,"researcher":0,"implementer":0,"reviewer":2,"curator":0}; assert d["role_capacity"] == want, d' \
  "$narrow/scheduling.json"
check "foreman's config gives the hosted role its raised capacity" python3 -I -c \
  'import json,sys; d=json.load(open(sys.argv[1])); want={"planner":0,"researcher":0,"implementer":0,"reviewer":2,"curator":0}; assert d["role_capacity"] == want, d' \
  "$narrow/config.json"

# The harness adapter's config: one named opencode agent per agent role, each with its own model alias.
check "opencode.json and config.json agree with factory_models" python3 -I "$root/tests/models_check.py" "$out"

[ "$failures" -eq 0 ]
