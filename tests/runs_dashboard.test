#!/usr/bin/env bash
# The runs dashboard: model cost, run outcomes, claims and reaped runs by agent role, over the chosen
# time range, so a counter that moves only when a run finishes still shows something between runs.
# Run against the real group_vars; no host needed.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
export RENDER_DIR="$out" ANSIBLE_CONFIG="$root/ansible.cfg"

failures=0
check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "ok   $name"; else
    echo "FAIL $name" >&2
    failures=$((failures + 1))
  fi
}

# dash <python>: runs the assertions with the parsed dashboard `dash` and its panels' queries `exprs`.
dash() {
  python3 -I -c '
import json, sys
dash = json.load(open(sys.argv[1]))
exprs = {p["title"]: [t["expr"] for t in p["targets"]] for p in dash["panels"]}
exec(sys.argv[2])
' "$out/runs.json" "$1"
}

if ! ansible-playbook "$root/tests/runs_dashboard.yml" >"$out/.log" 2>&1; then
  cat "$out/.log" >&2
  echo "FAIL render playbook" >&2
  exit 1
fi

check "the dashboard is valid JSON with its own uid" dash '
assert dash["uid"] == "factory-runs", dash["uid"]
assert dash["title"] == "Factory runs", dash["title"]
'
# Each run is its own process, so its counters restart at zero and Prometheus holds one sample per run,
# that run'"'"'s whole count. increase() reads each restart as a reset and drops the first run'"'"'s share;
# summing the samples in each graph step counts every run exactly once.
check "model cost is a point per run, summed in each step by role and by model" dash '
assert exprs["Model cost by agent role"] == ["sum by (factory_agent_role) (sum_over_time(factory_run_cost_total[$__interval]))"], exprs
assert exprs["Model cost by model"] == ["sum by (gen_ai_request_model) (sum_over_time(factory_run_cost_total[$__interval]))"], exprs
for p in dash["panels"][:2]:
    assert p["type"] == "timeseries", p["title"]
    assert p["fieldConfig"]["defaults"]["custom"]["drawStyle"] == "points", p["title"]
'
check "finished runs are state timelines of outcome and of role" dash '
assert exprs["Runs by outcome"] == ["sum by (factory_agent_role, factory_outcome) (sum_over_time(factory_run_outcomes_total[$__interval]))"], exprs
assert exprs["Runs by agent role"] == ["sum by (factory_agent_role) (sum_over_time(factory_run_outcomes_total[$__interval]))"], exprs
'
check "claims and reaped runs are state timelines by role" dash '
assert exprs["Issues claimed by agent role"] == ["sum by (factory_agent_role) (sum_over_time(factory_poll_claims_total[$__interval]))"], exprs
assert exprs["Dead runs reaped by agent role"] == ["sum by (factory_agent_role) (sum_over_time(factory_runs_reaped_total[$__interval]))"], exprs
'
check "the four count panels are state timelines" dash '
types = {p["title"]: p["type"] for p in dash["panels"]}
assert [types[t] for t in exprs if not t.startswith("Model cost")] == ["state-timeline"] * 4, types
'
check "a failed outcome is drawn red" dash '
panel = next(p for p in dash["panels"] if p["title"] == "Runs by outcome")
override = next(o for o in panel["fieldConfig"]["overrides"] if "failed" in o["matcher"]["options"])
assert {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}} in override["properties"], override
'
check "no panel uses a window that empties between runs" dash '
for title, queries in exprs.items():
    for q in queries:
        assert "$__rate_interval" not in q and "$__range" not in q and "[5m]" not in q, (title, q)
'
check "every panel reads the provisioned Prometheus datasource" dash '
assert {p["datasource"]["uid"] for p in dash["panels"]} == {"prometheus"}, dash["panels"]
assert all(t["datasource"]["uid"] == "prometheus" for p in dash["panels"] for t in p["targets"])
'
check "every panel queries a range, so each run is a point at its own time" dash '
assert all(t.get("range") is True and not t.get("instant") for p in dash["panels"] for t in p["targets"]), dash["panels"]
'
check "the dashboard is installed beside the host health one" grep -Fq \
  'dest: /etc/grafana/dashboards/runs.json' "$out/telemetry-tasks.yml"

[ "$failures" -eq 0 ]
