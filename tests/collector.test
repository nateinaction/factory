#!/usr/bin/env bash
# What the collector role renders to: OTLP on loopback only, an attribute allowlist that redacts
# everything else, foreman's diagnostics shipped from dagu's run logs, span-derived metrics, a bounded
# local buffer, and a backend exporter only once one is named. The rendered config is validated and
# exercised by the real pinned collector binary. Run against the real group_vars; no host needed.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
export RENDER_DIR="$out" ANSIBLE_CONFIG="$root/ansible.cfg"

failures=0
check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "ok   $name"; else echo "FAIL $name" >&2; failures=$((failures + 1)); fi
}

# conf <python>: runs the assertions with the parsed config `c` and the group_vars `v` in scope.
conf() {
  python3 -I -c '
import json, sys
d = json.load(open(sys.argv[1]))
c, v = d["c"], d["v"]
exec(sys.argv[2])
' "$out/config.json" "$1"
}

# render [backend] renders once into $RENDER_DIR; render_again re-renders into the same directory.
render() {
  if ! COLLECTOR_BACKEND="$1" ansible-playbook "$root/tests/collector.yml" >"$out/.log" 2>&1; then
    cat "$out/.log" >&2
    echo "FAIL render playbook" >&2
    exit 1
  fi
}

render_again() {
  if ! COLLECTOR_BACKEND="$1" ansible-playbook "$root/tests/collector.yml" >"$out/.second" 2>&1; then
    cat "$out/.second" >&2
    echo "FAIL second render playbook" >&2
    exit 1
  fi
}

# --- no backend yet ---
render ""

check "the pinned collector accepts the rendered config" \
  otelcol-contrib validate --config="$out/config.yaml"
check "OTLP gRPC listens on loopback" conf \
  'assert c["receivers"]["otlp"]["protocols"]["grpc"]["endpoint"] == "127.0.0.1:4317"'
check "OTLP HTTP listens on loopback" conf \
  'assert c["receivers"]["otlp"]["protocols"]["http"]["endpoint"] == "127.0.0.1:4318"'
check "nothing in the config binds a wildcard address" bash -c "! grep -E '0\.0\.0\.0|\[::\]' '$out/config.yaml'"
check "the collector's own metrics endpoint is off" conf \
  'assert c["service"]["telemetry"]["metrics"]["level"] == "none"'
check "redaction drops every key but the allowlist" conf '
r = c["processors"]["redaction"]
assert r["allow_all_keys"] is False
assert r["allowed_keys"] == v["factory_collector_allowed_attributes"]
'
check "redaction runs on traces and metrics before anything leaves" conf '
for name in ("traces", "metrics", "logs"):
    procs = c["service"]["pipelines"][name]["processors"]
    assert procs.index("memory_limiter") < procs.index("redaction") < procs.index("batch"), name
'
check "host health labels are renamed before redaction" conf '
procs = c["service"]["pipelines"]["metrics"]["processors"]
assert procs.index("transform/host") < procs.index("redaction"), procs
statements = str(c["processors"]["transform/host"])
assert "factory.host_health.kind" in statements and "factory.host_health.state" in statements, statements
assert "factory.host_health.mountpoint" in statements, statements
'
check "the allowlist keeps the issue, state, failure kind and usage a run needs" conf '
allowed = set(v["factory_collector_allowed_attributes"])
assert {"factory.issue", "factory.state", "factory.failure_kind", "factory.run_id",
        "factory.peak_context", "factory.cost", "gen_ai.request.model",
        "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens"} <= allowed, allowed
'
check "the allowlist keeps a poll's skip reason and a process's verb and exit code" conf '
allowed = set(v["factory_collector_allowed_attributes"])
assert {"factory.skip_reason", "factory.attempt",
        "factory.verb", "factory.exit_code"} <= allowed, allowed
'
check "the allowlist keeps every field of a security event's record" conf '
allowed = set(v["factory_collector_allowed_attributes"])
assert {"event", "outcome", "host", "agent_role", "repository", "issue"} <= allowed, allowed
'
check "the allowlist does not admit generic host health keys" conf '
allowed = set(v["factory_collector_allowed_attributes"])
assert not ({"kind", "state", "mountpoint", "fstype", "device"} & allowed), allowed
assert {"factory.host_health.kind", "factory.host_health.state",
        "factory.host_health.mountpoint", "factory.host_health.fstype",
        "factory.host_health.device"} <= allowed
'
check "spanmetrics turns spans into metrics" conf '
p = c["service"]["pipelines"]
assert "spanmetrics" in c["connectors"]
assert "spanmetrics" in p["traces"]["exporters"]
assert "spanmetrics" in p["metrics"]["receivers"]
'
check "spanmetrics dimensions stay inside the allowlist" conf '
dims = [d["name"] for d in c["connectors"]["spanmetrics"].get("dimensions", [])]
assert set(dims) <= set(v["factory_collector_allowed_attributes"]), dims
'
check "dagu's run diagnostics are read from the factory DAGs' stderr" conf '
r = c["receivers"]["filelog/foreman"]
assert r["include"] == [v["factory_dagu_logs_dir"] + "/factory-*/dag-run_*/*.err"], r["include"]
assert r["storage"] in c["service"]["extensions"], r["storage"]
types = [op["type"] for op in r["operators"]]
assert types == ["filter", "json_parser", "trace_parser", "move"], types
assert "filelog/foreman" in c["service"]["pipelines"]["logs"]["receivers"]
'
check "a file reached through a symlink is dropped before it is parsed" conf '
r = c["receivers"]["filelog/foreman"]
assert r["include_file_path_resolved"] is True, r
op = r["operators"][0]
assert op["type"] == "filter", op
# The trailing slash keeps a sibling directory whose name starts the same way out of the prefix.
assert "path_resolved" in op["expr"], op
assert v["factory_dagu_logs_dir"] + "/\"" in op["expr"], op
'
check "the JSON parser drops a line it cannot parse instead of shipping it raw" conf '
op = next(op for op in c["receivers"]["filelog/foreman"]["operators"] if op["type"] == "json_parser")
assert op["on_error"] == "drop", op
'
check "the filelog receiver resumes from disk after a restart" conf '
storage = c["extensions"]["file_storage/offsets"]
assert storage["directory"] == v["factory_collector_state_dir"] + "/offsets", storage
assert storage.get("create_directory") is True
'
check "no backend means nothing is exported" conf '
assert not [k for k in c["exporters"] if k.startswith("otlp")]
for name in ("traces", "metrics", "logs"):
    assert "nop" in c["service"]["pipelines"][name]["exporters"], name
'

# --- a second run of the role's play changes nothing ---
render_again ""
check "a second render reports no changes" grep -Fq 'changed=0' "$out/.second"

# --- backend named ---
render "telemetry.example"

check "the pinned collector accepts the backend config" \
  otelcol-contrib validate --config="$out/config.yaml"
check "a named backend receives traces, metrics and diagnostics on the backend's ports" conf '
e = c["exporters"]
assert e["otlp_grpc/traces"]["endpoint"] == "telemetry.example:%d" % v["factory_telemetry_tempo_otlp_port"]
assert e["otlp_http/metrics"]["endpoint"] == "http://telemetry.example:%d/api/v1/otlp" % v["factory_telemetry_prometheus_port"]
assert e["otlp_http/logs"]["endpoint"] == "http://telemetry.example:%d/otlp" % v["factory_telemetry_loki_port"]
p = c["service"]["pipelines"]
assert "otlp_grpc/traces" in p["traces"]["exporters"]
assert "otlp_http/metrics" in p["metrics"]["exporters"]
assert "otlp_http/logs" in p["logs"]["exporters"]
'
check "the unreachable-server buffer is bounded and survives a restart" conf '
for name in ("otlp_grpc/traces", "otlp_http/metrics", "otlp_http/logs"):
    q = c["exporters"][name]["sending_queue"]
    assert q["enabled"] is True
    assert q["queue_size"] == v["factory_collector_queue_size"]
    assert q["storage"] in c["service"]["extensions"]
    assert q["storage"].startswith("file_storage")
'
check "the collector creates its queue directory, so a fresh host does not crash-loop" conf '
storage = c["extensions"]["file_storage/queue"]
assert storage["directory"] == v["factory_collector_state_dir"] + "/queue", storage
assert storage.get("create_directory") is True, storage
'
check "the memory limit is set" conf \
  'assert c["processors"]["memory_limiter"]["limit_mib"] == v["factory_collector_memory_limit_mib"]'

unit="$out/otelcol.service"
check "the unit runs as the unprivileged collector user" grep -Fxq 'User=otelcol' "$unit"
check "the unit runs the contrib binary on the rendered config" \
  grep -Fxq 'ExecStart=/nix/var/nix/profiles/default/bin/otelcol-contrib --config=/etc/otelcol/config.yaml' "$unit"
check "the unit may read dagu's 0600 run logs and nothing more" bash -c "
  grep -Fxq 'AmbientCapabilities=CAP_DAC_READ_SEARCH' '$unit' &&
  grep -Fxq 'CapabilityBoundingSet=CAP_DAC_READ_SEARCH' '$unit'"
check "the unit may write only the collector's state directory" \
  grep -Fxq 'ReadWritePaths=/var/lib/otelcol' "$unit"

# --- the real binary's config, exercised end to end ---
check "a non-allowlisted attribute never leaves the collector" \
  python3 -I "$root/tests/collector_otlp.py" "$root"

[ "$failures" -eq 0 ]
