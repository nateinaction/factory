#!/usr/bin/env bash
# What the telemetry role renders to: every store bound to loopback and bounded by age or size, the
# datasources linked so a run's trace id leads to its metrics and diagnostics, and the memory the
# services may use fitting the budget. Run against the real group_vars; no host needed.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
export RENDER_DIR="$out" ANSIBLE_CONFIG="$root/ansible.cfg" RENDER_OWNER="$(id -un)" RENDER_GROUP="$(id -gn)"

failures=0
check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "ok   $name"; else echo "FAIL $name" >&2; failures=$((failures + 1)); fi
}

# mode <path> <expected>: the octal permission bits.
mode() { [ "$(python3 -c 'import os,sys; print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$1")" = "$2" ]; }

# conf <python>: runs the assertions with the parsed configs and the group_vars `v` in scope.
conf() {
  python3 -I -c '
import json, sys
d = json.load(open(sys.argv[1]))
tempo, loki, ds, v = d["tempo"], d["loki"], d["datasources"], d["v"]
exec(sys.argv[2])
' "$out/config.json" "$1"
}

admin_password="test-admin-password"
if ! ansible-playbook "$root/tests/telemetry.yml" \
  -e "factory_telemetry_grafana_admin_password=$admin_password" >"$out/.log" 2>&1; then
  cat "$out/.log" >&2
  echo "FAIL render playbook" >&2
  exit 1
fi

# --- not reachable off the tailnet: every listener is loopback ---
check "nothing binds a wildcard address" \
  bash -c "! grep -E '0\.0\.0\.0|\[::\]' '$out'/*.yaml '$out'/grafana.ini '$out'/*.service"
check "tempo listens on loopback only" conf '
s = tempo["server"]
assert s["http_listen_address"] == "127.0.0.1" and s["grpc_listen_address"] == "127.0.0.1"
g = tempo["distributor"]["receivers"]["otlp"]["protocols"]["grpc"]["endpoint"]
assert g == "127.0.0.1:%d" % v["factory_telemetry_tempo_otlp_port"], g
'
check "loki listens on loopback only" conf '
s = loki["server"]
assert s["http_listen_address"] == "127.0.0.1" and s["grpc_listen_address"] == "127.0.0.1"
'
check "grafana listens on loopback only" grep -Fxq 'http_addr = 127.0.0.1' "$out/grafana.ini"
check "prometheus listens on loopback only" \
  grep -Fq -- '--web.listen-address=127.0.0.1:' "$out/prometheus.service"
check "prometheus loads its alert rules from a template" bash -c "
  grep -Fq -- 'rule_files:' '$out/prometheus.yaml' &&
  grep -Fq -- '/etc/prometheus/alerts.yaml' '$out/prometheus.yaml'"
check "grafana's admin login is the one the play is given" python3 -I -c '
import json, sys
v = json.load(open(sys.argv[1]))["v"]
text = open(sys.argv[2]).read()
assert "admin_user = " + v["factory_telemetry_grafana_admin_user"] in text, text
assert "admin_password = " + v["factory_telemetry_grafana_admin_password"] in text, text
' "$out/config.json" "$out/grafana.ini"
check "grafana reads its root-only config as a systemd credential" bash -c "
  grep -Fxq 'LoadCredential=grafana.ini:/etc/grafana/grafana.ini' '$out/grafana.service' &&
  grep -Fq -- '--config=%d/grafana.ini' '$out/grafana.service'"

# --- Grafana's admin password has no default, and its config is root-only ---
check "group_vars sets no grafana admin password default" \
  bash -c "! grep -Eq '^factory_telemetry_grafana_admin_password:' '$root/group_vars/factory.yml'"
check "grafana.ini is not readable by group or world" mode "$out/grafana.ini" 600

# Without the extra var the play is given no password, and must fail closed before writing anything.
mkdir -p "$out/no-password"
if RENDER_DIR="$out/no-password" ansible-playbook "$root/tests/telemetry.yml" >"$out/no-password.log" 2>&1; then
  echo "FAIL an unset grafana admin password was accepted" >&2
  failures=$((failures + 1))
else
  echo "ok   an unset grafana admin password fails the play"
fi
check "the failure names the password variable" \
  grep -Fq 'factory_telemetry_grafana_admin_password is unset' "$out/no-password.log"
check "nothing is written without a password" bash -c '[ -z "$(ls -A "$1")" ]' _ "$out/no-password"
check "prometheus accepts OTLP and stores exemplars" bash -c "
  grep -Fq -- '--web.enable-otlp-receiver' '$out/prometheus.service' &&
  grep -Fq -- 'exemplar-storage' '$out/prometheus.service'"

# --- every store has a retention bound ---
check "prometheus retention is bounded by age and size" bash -c "
  grep -Eq -- '--storage.tsdb.retention.time=[0-9]+[dh]' '$out/prometheus.service' &&
  grep -Eq -- '--storage.tsdb.retention.size=[0-9]+[KMG]B' '$out/prometheus.service'"
check "tempo retention is bounded by age" conf '
assert tempo["backend_scheduler"]["provider"]["compaction"]["compaction"]["block_retention"].endswith("h")
assert tempo["backend_worker"]["compaction"]["block_retention"].endswith("h")
'
check "loki retention is bounded by age and enforced" conf '
assert loki["limits_config"]["retention_period"].endswith("h")
assert loki["compactor"]["retention_enabled"] is True
'

# --- a run is found from its trace id ---
check "tempo links a trace to its logs and metrics" conf '
t = next(d for d in ds["datasources"] if d["type"] == "tempo")
j = t["jsonData"]
assert j["tracesToLogsV2"]["datasourceUid"] == "loki"
assert j["tracesToMetrics"]["datasourceUid"] == "prometheus"
'
check "loki turns a trace id in a diagnostic into a Tempo link" conf '
l = next(d for d in ds["datasources"] if d["type"] == "loki")
f = l["jsonData"]["derivedFields"][0]
assert f["datasourceUid"] == "tempo" and f["matcherType"] == "label" and f["matcherRegex"] == "trace_id"
'
check "datasource uids are the ones the links name" conf '
assert {d["uid"] for d in ds["datasources"]} == {"prometheus", "tempo", "loki"}
'

# --- memory budget ---
check "service memory limits fit the budget" conf '
total = sum(v["factory_telemetry_memory_max_mib"].values())
assert total <= v["factory_telemetry_memory_budget_mib"], total
'
for svc in prometheus tempo loki grafana; do
  check "$svc unit is memory-capped and sandboxed" bash -c "
    grep -Eq '^MemoryMax=[0-9]+M' '$out/$svc.service' &&
    grep -Fxq 'DynamicUser=yes' '$out/$svc.service' &&
    grep -Fxq 'NoNewPrivileges=true' '$out/$svc.service'"
done

# systemd reads StartLimit* only in [Unit]; in [Service] they are ignored.
check "every backend unit reads its restart limit from [Unit]" python3 -I -c '
import sys
for path in sys.argv[1:]:
    section, seen = None, {}
    for line in open(path):
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line
            continue
        key = line.partition("=")[0]
        if key in ("StartLimitIntervalSec", "StartLimitBurst"):
            seen[key] = section
            assert section == "[Unit]", (path, key, section)
    assert set(seen) == {"StartLimitIntervalSec", "StartLimitBurst"}, (path, seen)
' "$out/prometheus.service" "$out/tempo.service" "$out/loki.service" "$out/grafana.service"

# --- the serve check names the exact listener, not a port number inside a longer one ---
mkdir -p "$out/bin"
ln -sf "$root/tests/fake_tailscale" "$out/bin/tailscale"

# serve <status file>: run the role's serve tasks with a fake tailscale and record its calls.
serve() {
  rm -f "$out/serve-calls"
  if ! TAILSCALE_STATUS_FILE="$1" TAILSCALE_CALLS_FILE="$out/serve-calls" \
    FAKE_TAILSCALE_BIN="$out/bin" ansible-playbook "$root/tests/serve.yml" >"$out/.serve" 2>&1; then
    cat "$out/.serve" >&2
    echo "FAIL serve playbook" >&2
    exit 1
  fi
}

# Every listener here ends in an extra digit, so the old substring check saw each port as served.
cat >"$out/unrelated-status" <<'EOF'
# Tailscale Serve is forwarding

|-- tcp://factory-1.example.ts.net:143170 (tailnet only)
|--> tcp://127.0.0.1:143170
|-- tcp://factory-1.example.ts.net:19090 (tailnet only)
|--> tcp://127.0.0.1:19090
|-- tcp://factory-1.example.ts.net:31000 (tailnet only)
|--> tcp://127.0.0.1:31000
https://factory-1.example.ts.net:30000 (tailnet only)
|-- / proxy http://127.0.0.1:30000
EOF
serve "$out/unrelated-status"
check "every ingest port is served past an unrelated longer port" bash -c "
  grep -Fxq -- 'serve --bg --tcp=14317 tcp://127.0.0.1:14317' '$out/serve-calls' &&
  grep -Fxq -- 'serve --bg --tcp=9090 tcp://127.0.0.1:9090' '$out/serve-calls' &&
  grep -Fxq -- 'serve --bg --tcp=3100 tcp://127.0.0.1:3100' '$out/serve-calls' &&
  grep -Fxq -- 'serve --bg --https=3000 http://127.0.0.1:3000' '$out/serve-calls'"

cat >"$out/exact-status" <<'EOF'
# Tailscale Serve is forwarding

|-- tcp://factory-1.example.ts.net:14317 (tailnet only)
|--> tcp://127.0.0.1:14317
|-- tcp://factory-1.example.ts.net:9090 (tailnet only)
|--> tcp://127.0.0.1:9090
|-- tcp://factory-1.example.ts.net:3100 (tailnet only)
|--> tcp://127.0.0.1:3100
https://factory-1.example.ts.net:3000 (tailnet only)
|-- / proxy http://127.0.0.1:3000
EOF
serve "$out/exact-status"
check "an already-set-up serve is left alone" bash -c '[ ! -s "$1" ]' _ "$out/serve-calls"

[ "$failures" -eq 0 ]
