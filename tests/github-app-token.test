#!/usr/bin/env bash
# Behaviour of roles/github_app/files/github-app-token against a fake GitHub API:
# each App mints only with its own credentials, and a missing or uninstalled App
# fails with nothing on stdout.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
script="$root/roles/github_app/files/github-app-token"
work="$(mktemp -d)"
server=""
trap '[ -z "$server" ] || kill "$server" 2>/dev/null; rm -rf "$work"' EXIT

# Apps with their own keys. "implementer" is App 1 and "reviewer" is App 2; "researcher" has no
# credentials. "paged", "wide" and "crowded" stand past a ceiling of the listing the tool reads.
for pair in implementer:1 reviewer:2 paged:3 wide:4 crowded:5 planner:6 curator:7; do
  app="${pair%%:*}"
  mkdir -p "$work/conf/$app"
  echo "${pair##*:}" >"$work/conf/$app/app-id"
  openssl genrsa -out "$work/conf/$app/private-key.pem" 2048 2>/dev/null
done

python3 -I "$root/tests/fake_github.py" >"$work/port" &
server=$!
for _ in $(seq 1 50); do
  [ -s "$work/port" ] && break
  sleep 0.1
done
port="$(cat "$work/port")"
export GITHUB_API_URL="http://127.0.0.1:$port" GITHUB_APP_DIR="$work/conf"

failures=0
# expect <name> <want-exit> <want-stdout> <args...>
expect() {
  local name="$1" want_code="$2" want_out="$3"
  shift 3
  local out code
  out="$("$script" "$@" 2>/dev/null)"
  code=$?
  if [ "$code" -eq 0 ] && [ "$want_code" -ne 0 ] || [ "$code" -ne 0 ] && [ "$want_code" -eq 0 ] || [ "$out" != "$want_out" ]; then
    echo "FAIL $name: exit $code, stdout '$out' (want exit $want_code, stdout '$want_out')" >&2
    failures=$((failures + 1))
  else
    echo "ok   $name"
  fi
}

expect "implementer mints its own repo-scoped token" 0 "tok-1-7-r" token --app implementer --repo o/r
expect "reviewer mints its own repo-scoped token" 0 "tok-2-7-r" token --app reviewer --repo o/r
expect "a read-only token is restricted to read permissions" 0 "tok-1-7-r-ro-contents+issues+metadata+pull_requests" \
  token --app implementer --repo o/r --read-only
expect "a read-only token is still one repository" 0 "tok-2-7-r-ro-contents+issues+metadata+pull_requests" \
  token --app reviewer --repo o/r --read-only
expect "a Planner read-only token asks for no Pull requests, which its App lacks" 0 \
  "tok-6-7-r-ro-contents+issues+metadata" token --app planner --repo o/r --read-only
expect "a Curator read-only token asks for no Contents or Pull requests, which its App lacks" 0 \
  "tok-7-7-r-ro-issues+metadata" token --app curator --repo o/r --read-only
expect "a read-only token for an unknown agent role is refused" 1 "" \
  token --app paged --repo o/paged --read-only
expect "an App not installed on the repo mints nothing" 1 "" token --app implementer --repo o/q
expect "an App without credentials mints nothing, and takes no other App's" 1 "" token --app researcher --repo o/r
expect "an app name cannot climb out of the config dir" 1 "" token --app ../implementer --repo o/r
expect "a repo must be owner/name" 1 "" token --app implementer --repo r
expect "a repo cannot traverse" 1 "" token --app implementer --repo ../r
expect "token needs --app" 1 "" token --repo o/r
expect "implementer lists its repositories" 0 "o/r" repositories --app implementer
expect "reviewer lists its repositories across installations" 0 "$(printf 'o/r\no/q')" repositories --app reviewer
expect "an App without credentials lists nothing" 1 "" repositories --app researcher
expect "unknown command" 1 "" frobnicate --app implementer

# expect_error <name> <want-stderr> <args...>
expect_error() {
  local name="$1" want_err="$2"
  shift 2
  local out err code
  out="$("$script" "$@" 2>"$work/err")"
  code=$?
  err="$(cat "$work/err")"
  if [ "$code" -eq 0 ] || [ -n "$out" ] || [[ "$err" != *"$want_err"* ]]; then
    echo "FAIL $name: exit $code, stdout '$out', stderr '$err' (want non-zero, no stdout, stderr with '$want_err')" >&2
    failures=$((failures + 1))
  else
    echo "ok   $name"
  fi
}

# expect_help <name> <args...>
expect_help() {
  local name="$1"
  shift
  local out code
  out="$("$script" "$@" 2>/dev/null)"
  code=$?
  if [ "$code" -ne 0 ] || [[ "$out" != *usage:* ]]; then
    echo "FAIL $name: exit $code, stdout '$out' (want exit 0, stdout with 'usage:')" >&2
    failures=$((failures + 1))
  else
    echo "ok   $name"
  fi
}

expect_help "the top level has --help" --help
expect_help "each command has --help" token --help
expect_help "each command has --help" repositories --help
expect_error "token needs --app, and says so" "usage:" token --repo o/r
expect_error "repositories needs --app, and says so" "usage:" repositories
expect_error "a repeated value flag is refused" "--app" token --app implementer --app reviewer --repo o/r
expect_error "a repeated switch is refused" "--read-only" token --app implementer --repo o/r --read-only --read-only
expect_error "a flag the command does not take is refused" "--repo" repositories --app implementer --repo o/r
expect_error "a conflicting --read-only on repositories is refused" \
  "unrecognized arguments: --read-only" repositories --app implementer --read-only
expect_error "a conflicting --read-only value on token is refused" \
  "ignored explicit argument 'x'" token --app implementer --repo o/r --read-only=x
expect_error "a flag with no value is refused" "--repo" token --app implementer --repo

# A listing that reaches its ceiling is a failure, never a truncated answer.
expect_error "an App whose installation listing is full on its last page lists nothing" \
  "longer than 10 pages" repositories --app paged
expect_error "an App whose repository listing is full on its last page lists nothing" \
  "longer than 10 pages" repositories --app wide
expect_error "an App installed past the installation cap lists nothing" \
  "over the 50" repositories --app crowded

[ "$failures" -eq 0 ]
