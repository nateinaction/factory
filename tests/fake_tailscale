#!/usr/bin/env bash
# A fake `tailscale` for tests/telemetry.test. `serve status` prints the file named by
# TAILSCALE_STATUS_FILE; every other `serve` call is appended to TAILSCALE_CALLS_FILE, so the test
# can see which serves the role decided to set up for a given status.
set -uo pipefail

if [ "${1:-} ${2:-}" = "serve status" ]; then
  cat "$TAILSCALE_STATUS_FILE"
  exit 0
fi

printf '%s\n' "$*" >>"$TAILSCALE_CALLS_FILE"
