#!/usr/bin/env bash
# Run go fix, go mod tidy, golangci-lint and the tests on the foreman module.
# Fail if any of them changes a file or reports a problem. Used by the
# pre-commit hook and CI.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root/foreman"

# A fingerprint of the module's file contents, independent of git's index.
fingerprint() {
  find . -type f -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256
}

before="$(fingerprint)"

go fix ./...
go mod tidy
golangci-lint run ./...
go test -race -shuffle=on ./...

after="$(fingerprint)"
if [ "$before" != "$after" ]; then
  echo "check-go: go fix or go mod tidy changed files; review and stage them" >&2
  diff <(echo "$before") <(echo "$after") >&2 || true
  exit 1
fi
