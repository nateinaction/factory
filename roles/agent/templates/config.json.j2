{#- foreman's view of factory_models: model, context cap and compaction per agent role, plus the
    step cap and deadline foreman enforces and the retro budget shared by every agent role. -#}
{%- set agents = {} -%}
{%- for role, m in factory_models.items() -%}
{%- set limits = factory_agent_limits[role] -%}
{%- set _ = agents.update({role: {'model': m.model, 'context_cap': m.context_cap | default(factory_context_cap) | int, 'compaction': m.compaction, 'steps': limits.steps | int, 'deadline_minutes': limits.deadline_minutes | int}}) -%}
{%- endfor -%}
{{ {'roles': github_apps | list | sort, 'agents': agents, 'retro': {'steps': factory_retro_steps | int, 'deadline_minutes': factory_retro_deadline_minutes | int}} | to_nice_json }}