#!/usr/bin/env python3
"""Turn a `ready-for-agent` GitHub issue into a reviewed pull request.

  finances-agent poll            (dagu server, every few minutes) claim one issue, queue its run
  finances-agent work ISSUE      (dagu worker) give factory a token, implement, record the outcome
  finances-agent review ISSUE    (dagu worker) give factory a token, review the PR, record the outcome
  finances-agent run ISSUE       (factory, via sudo) clone, run opencode, push, open the PR, retro
  finances-agent review-run ISSUE  (factory, via sudo) clone the PR branch, run the review, post it

Labels drive the flow: ready-for-agent -> agent-working -> ready-for-agent-review
-> agent-reviewing -> agent-done, or back to ready-for-agent when the review
finds anything high or medium (at most MAX_REVIEW_ROUNDS times), or agent-failed.

`poll`, `work` and `review` run as the dagu user, which owns the GitHub App key.
Polling involves no model and no worker. `work` and `review` mint a repo-scoped
token, write it where the factory user can read it, and start the factory half.
Re-running any command is safe: claiming is a label swap that fails closed when
someone else got there first, and reviews and retros are keyed by commit SHA, so
a repeat updates or skips rather than duplicating.

Config: /etc/factory-agent/config.json (or $FACTORY_AGENT_CONFIG), written by the
role, as {"repo": "owner/name", "model": "provider/model"}. A file rather than the
environment because sudo resets the environment between `work` and `run`.
"""
import base64
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

API = "https://api.github.com"
TOKEN_FILE = "/run/factory/gh-token"
KEY_FILE = os.path.expanduser("~/.config/factory-agent/openrouter-key")
WORK_ROOT = os.path.expanduser("~/work")
SELF = "/usr/local/bin/finances-agent"
WORK_DAG = "finances-agent-work"
CONFIG_FILE = os.environ.get("FACTORY_AGENT_CONFIG", "/etc/factory-agent/config.json")

READY, WORKING = "ready-for-agent", "agent-working"
REVIEW_READY, REVIEWING = "ready-for-agent-review", "agent-reviewing"
DONE, FAILED = "agent-done", "agent-failed"
RETRO_LABEL, RETRO_TITLE = "retro", "Agent retros"

SEVERITIES = ("high", "medium", "low")
BLOCKING = ("high", "medium")
MAX_REVIEW_ROUNDS = 3
# Exit codes of `review-run`, read by `review`.
REVIEW_CLEAN, REVIEW_FINDINGS, REVIEW_EXHAUSTED = 0, 10, 11

ISSUES_PER_PAGE = 20
PAGE_SIZE = 100
MAX_PAGES = 5
BODY_LIMIT_CHARS = 20_000
COMMENT_LIMIT_CHARS = 60_000
HTTP_TIMEOUT_S = 20
GIT_TIMEOUT_S = 300
AGENT_TIMEOUT_S = 3600
RETRO_TIMEOUT_S = 900
REVIEW_TIMEOUT_S = 1800


# --- pure core ---------------------------------------------------------------

def parse_issue_number(text):
    """An issue number is digits only: it ends up in a path and a branch name."""
    if not re.fullmatch(r"[0-9]{1,9}", text):
        raise ValueError(f"not an issue number: {text!r}")
    return int(text)


def pick_issue(issues):
    """Oldest first, as the API returns them. The issues endpoint also lists PRs."""
    return next((i for i in issues if "pull_request" not in i), None)


def branch_name(number):
    return f"agent/issue-{number}"


def agent_prompt(repo, issue, feedback=None):
    body = (issue.get("body") or "")[:BODY_LIMIT_CHARS]
    rework = ""
    if feedback:
        rework = (
            "\n\nThe open pull request for this branch was reviewed and the review found "
            "problems. Fix every high and medium finding below on top of the existing "
            f"commits, then commit.\n\nReview:\n{feedback[:BODY_LIMIT_CHARS]}"
        )
    return (
        f"Use the `implement` skill to implement GitHub issue #{issue['number']} "
        f"of {repo}. The repository is the current directory, already on its own "
        f"branch. Commit your work to this branch; do not push.\n\n"
        f"Title: {issue['title']}\n\n{body}{rework}"
    )


def retro_prompt(repo, number, out_path):
    return (
        f"Use the `retro` skill on the session you just finished, which implemented issue "
        f"#{number} of {repo}. Do not change the repository and do not ask questions. "
        f"Instead of presenting the candidates to a user, write them as Markdown, most "
        f"severe first, to {out_path}; they will be posted as a comment on the retro ticket."
    )


def review_prompt(base, spec_path, out_path):
    return (
        f"Use the `code-review` skill. The fixed point is origin/{base}; the spec is the "
        f"issue saved at {spec_path}. Do not change the repository, do not post anything, "
        f"and do not ask questions. Classify every finding as high (a bug, a spec miss or a "
        f"security problem that must be fixed before merge), medium (a documented-standard "
        f"breach or a notable defect) or low (a judgement call or nit). Write the result as "
        f'JSON to {out_path}: {{"summary": "<one paragraph>", "findings": [{{"severity": '
        f'"high|medium|low", "title": "...", "detail": "...", "location": "file:line or empty"}}]}}. '
        f"An empty findings list means the change is clean."
    )


def review_marker(sha):
    return f"<!-- agent-review:{sha} -->"


def retro_marker(number, sha):
    return f"<!-- agent-retro:{number}:{sha} -->"


def parse_review(text):
    """Strict: anything malformed raises, so a bad review can never read as an approval."""
    data = json.loads(text)
    summary, raw = data["summary"], data["findings"]
    if not isinstance(summary, str) or not isinstance(raw, list):
        raise ValueError("review needs a string summary and a list of findings")
    findings = []
    for f in raw:
        if f["severity"] not in SEVERITIES:
            raise ValueError(f"unknown severity: {f['severity']!r}")
        findings.append({"severity": f["severity"], "title": str(f["title"]),
                         "detail": str(f["detail"]), "location": str(f.get("location") or "")})
    return summary, findings


def blocking(findings):
    return [f for f in findings if f["severity"] in BLOCKING]


def render_review(sha, summary, findings):
    lines = [review_marker(sha), "## Agent review", "", summary]
    for sev in SEVERITIES:
        group = [f for f in findings if f["severity"] == sev]
        if group:
            lines += ["", f"### {sev.capitalize()} ({len(group)})"]
            lines += [f"- **{f['title']}**{' (`' + f['location'] + '`)' if f['location'] else ''}: "
                      f"{f['detail']}" for f in group]
    if not findings:
        lines += ["", "No findings."]
    return "\n".join(lines)[:COMMENT_LIMIT_CHARS]


def starts_with(items, prefix):
    """Comments and reviews whose body starts with a marker, in API order."""
    return [i for i in items if (i.get("body") or "").startswith(prefix)]


def review_rounds(reviews, sha):
    """Distinct commits reviewed so far, counting `sha` whether or not it is posted yet."""
    marked = {(r["body"]).split("\n", 1)[0] for r in starts_with(reviews, "<!-- agent-review:")}
    return len(marked | {review_marker(sha)})


def git_auth_env(token):
    """Credentials for git over the environment, so they never appear in argv."""
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    return {
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "http.https://github.com/.extraheader",
        "GIT_CONFIG_VALUE_0": f"Authorization: Basic {basic}",
        "GIT_TERMINAL_PROMPT": "0",
    }


# --- GitHub (edge) -----------------------------------------------------------

def api(method, path, token, body=None):
    req = urllib.request.Request(
        API + path, method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "finances-agent",
                 "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT_S) as r:
        raw = r.read()
    return json.loads(raw) if raw else None


def paged(path, token):
    """Every item of a list endpoint, up to MAX_PAGES pages."""
    items = []
    for page in range(1, MAX_PAGES + 1):
        sep = "&" if "?" in path else "?"
        got = api("GET", f"{path}{sep}per_page={PAGE_SIZE}&page={page}", token)
        items += got
        if len(got) < PAGE_SIZE:
            break
    return items


def list_labeled(repo, label, token):
    q = f"state=open&labels={label}&sort=created&direction=asc&per_page={ISSUES_PER_PAGE}"
    return api("GET", f"/repos/{repo}/issues?{q}", token)


def comment(repo, number, token, text):
    api("POST", f"/repos/{repo}/issues/{number}/comments", token, {"body": text})


def claim(repo, number, token, src, dst):
    """Swap src -> dst. False when src is already gone: someone else claimed it."""
    try:
        api("DELETE", f"/repos/{repo}/issues/{number}/labels/{src}", token)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        raise
    api("POST", f"/repos/{repo}/issues/{number}/labels", token, {"labels": [dst]})
    return True


def finish(repo, number, token, src, dst, text):
    try:
        api("DELETE", f"/repos/{repo}/issues/{number}/labels/{src}", token)
    except urllib.error.HTTPError as e:
        if e.code != 404:  # already removed by a person: fine, still record the outcome
            raise
    api("POST", f"/repos/{repo}/issues/{number}/labels", token, {"labels": [dst]})
    comment(repo, number, token, text)


def existing_pr(repo, branch, token):
    owner = repo.split("/")[0]
    pulls = api("GET", f"/repos/{repo}/pulls?state=open&head={owner}:{branch}", token)
    return pulls[0] if pulls else None


def latest_review_body(repo, pr_number, token):
    ours = starts_with(paged(f"/repos/{repo}/pulls/{pr_number}/reviews", token), "<!-- agent-review:")
    return ours[-1]["body"] if ours else None


def retro_ticket(repo, token):
    """The one open retro ticket, created on first use."""
    found = pick_issue(list_labeled(repo, RETRO_LABEL, token))
    return found or api("POST", f"/repos/{repo}/issues", token, {
        "title": RETRO_TITLE, "labels": [RETRO_LABEL],
        "body": "One comment per agent implementation run, from the retro skill.",
    })


def post_retro(repo, number, sha, text, token):
    """A comment on the retro ticket, keyed by issue and commit so a repeat updates it."""
    ticket = retro_ticket(repo, token)["number"]
    marker = retro_marker(number, sha)
    body = f"{marker}\n## Retro: #{number}\n\n{text}"[:COMMENT_LIMIT_CHARS]
    mine = starts_with(paged(f"/repos/{repo}/issues/{ticket}/comments", token), marker)
    if mine:
        api("PATCH", f"/repos/{repo}/issues/comments/{mine[0]['id']}", token, {"body": body})
    else:
        comment(repo, ticket, token, body)


def post_review(repo, pr_number, sha, token, body, approve):
    path = f"/repos/{repo}/pulls/{pr_number}/reviews"
    if approve:
        try:
            api("POST", path, token, {"commit_id": sha, "body": body, "event": "APPROVE"})
            return
        except urllib.error.HTTPError as e:
            if e.code != 422:
                raise
            # GitHub forbids approving your own PR, and the App opened this one.
            body += ("\n\n_No high or medium findings. GitHub rejected the approval because "
                     "the review agent is also the pull request's author._")
    api("POST", path, token, {"commit_id": sha, "body": body, "event": "COMMENT"})


# --- commands (shell) --------------------------------------------------------

def mint_token(repo_name):
    # stderr is inherited so the helper's error reaches the dagu log; it never prints the token there.
    out = subprocess.run(["/usr/local/bin/github-app-token", "token", "--repo", repo_name],
                         stdout=subprocess.PIPE, text=True, check=True, timeout=30)
    return out.stdout.strip()


def write_token_file(token):
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w") as f:
        f.write(token)
    os.chmod(TOKEN_FILE, 0o640)  # group factory, set by the directory's setgid bit


def cmd_poll(repo):
    """Deterministic and cheap: no model involved. Claim at most one issue and queue its run.
    Reviews go first: they are short, and they unblock the PRs already waiting."""
    token = mint_token(repo.split("/")[1])
    for src, dst, mode, note in (
        (REVIEW_READY, REVIEWING, "review", "Picked up for review by the factory agent."),
        (READY, WORKING, "work", "Picked up by the factory agent."),
    ):
        issue = pick_issue(list_labeled(repo, src, token))
        if issue is None:
            continue
        number = issue["number"]
        if not claim(repo, number, token, src, dst):
            print(f"issue {number} was claimed by someone else")
            return 0
        comment(repo, number, token, note)
        try:
            subprocess.run(["/usr/local/bin/dagu", "enqueue", WORK_DAG, "--",
                            f"ISSUE={number}", f"MODE={mode}"], check=True, timeout=GIT_TIMEOUT_S)
        except Exception as e:  # the issue must not stay claimed with nothing running
            print(f"finances-agent: {type(e).__name__}: {e}", file=sys.stderr)
            finish(repo, number, token, dst, FAILED, "Could not queue the agent run; see the dagu log.")
            return 1
        return 0
    print("nothing ready")
    return 0


def run_as_factory(sub, number, token):
    """Exit code of `finances-agent <sub> N` run as factory, with the token file in place."""
    write_token_file(token)
    try:
        r = subprocess.run(["sudo", "-n", "-u", "factory", SELF, sub, str(number)],
                           timeout=AGENT_TIMEOUT_S + GIT_TIMEOUT_S * 2)
        return r.returncode
    finally:
        os.remove(TOKEN_FILE)  # the token also dies within the hour; don't leave it lying around


def factory_exit(repo, sub, number):
    try:
        return run_as_factory(sub, number, mint_token(repo.split("/")[1]))
    except Exception as e:  # recorded in the dagu log; the issue must not stay claimed
        print(f"finances-agent: {type(e).__name__}: {e}", file=sys.stderr)
        return None


def cmd_work(repo, number):
    """On the worker: hand the factory user a token, run the agent, record the outcome."""
    code = factory_exit(repo, "run", number)
    token = mint_token(repo.split("/")[1])  # fresh: the run may have outlived the first one
    if code == 0:
        finish(repo, number, token, WORKING, REVIEW_READY,
               "The agent finished; see the linked pull request. Queued for review.")
        return 0
    finish(repo, number, token, WORKING, FAILED,
           "The agent failed. Check the dagu run log, then re-apply `ready-for-agent` to retry.")
    return 1


def cmd_review(repo, number):
    """On the worker: review the issue's PR and route the issue by what the review found."""
    code = factory_exit(repo, "review-run", number)
    token = mint_token(repo.split("/")[1])
    if code == REVIEW_CLEAN:
        finish(repo, number, token, REVIEWING, DONE,
               "Review found no high or medium issues; see the pull request.")
    elif code == REVIEW_FINDINGS:
        finish(repo, number, token, REVIEWING, READY,
               "Review found high or medium issues, posted on the pull request. Sent back to the agent.")
    elif code == REVIEW_EXHAUSTED:
        finish(repo, number, token, REVIEWING, FAILED,
               f"Review still found high or medium issues after {MAX_REVIEW_ROUNDS} rounds. "
               "A person needs to look at the pull request.")
    else:
        finish(repo, number, token, REVIEWING, FAILED,
               "The review failed. Check the dagu run log, then re-apply `ready-for-agent-review` to retry.")
    return 0 if code in (REVIEW_CLEAN, REVIEW_FINDINGS) else 1


def run(argv, **kw):
    """Run a command, never through a shell, always with a ceiling."""
    return subprocess.run(argv, check=True, timeout=kw.pop("timeout", GIT_TIMEOUT_S), **kw)


def read_secrets():
    with open(TOKEN_FILE) as f:
        token = f.read().strip()
    with open(KEY_FILE) as f:
        return token, f.read().strip()


def fresh_path(name):
    """A scratch path outside the clone, empty so a re-run cannot read a stale result."""
    os.makedirs(WORK_ROOT, exist_ok=True)
    path = os.path.join(WORK_ROOT, name)
    if os.path.isdir(path):
        shutil.rmtree(path)
    elif os.path.exists(path):
        os.remove(path)
    return path


def rev_parse(git):
    return run([*git, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()


def cmd_run(repo, model, number):
    token, openrouter_key = read_secrets()
    issue = api("GET", f"/repos/{repo}/issues/{number}", token)
    branch = branch_name(number)
    workdir = fresh_path(f"issue-{number}")  # a clean slate makes a re-run equal to a first run

    git_env = {**os.environ, **git_auth_env(token)}
    run(["git", "clone", f"https://github.com/{repo}.git", workdir], env=git_env)
    git = ["git", "-C", workdir, "-c", "user.name=factory-agent",
           "-c", "user.email=factory-agent@users.noreply.github.com"]
    pr = existing_pr(repo, branch, token)
    feedback = None
    if pr:  # rework: build on the reviewed commits instead of discarding them
        run([*git, "fetch", "origin", branch], env=git_env)
        run([*git, "checkout", "-B", branch, f"origin/{branch}"])
        feedback = latest_review_body(repo, pr["number"], token)
    else:
        run([*git, "checkout", "-B", branch])
    start = rev_parse(git)

    agent_env = {**os.environ, "OPENROUTER_API_KEY": openrouter_key}
    run(["opencode", "run", "--model", model, agent_prompt(repo, issue, feedback)],
        cwd=workdir, env=agent_env, timeout=AGENT_TIMEOUT_S)

    # Never discard the agent's work silently: no new commits means no PR, and that is a failure.
    new = run([*git, "rev-list", "--count", f"{start}..{branch}"],
              capture_output=True, text=True).stdout.strip()
    if new == "0":
        raise RuntimeError("the agent made no commits")
    # agent/* branches are ours alone; a first run replaces any stale one, a rework fast-forwards.
    run([*git, "push", *([] if pr else ["--force"]), "origin", branch], env=git_env)

    if not pr:
        pr = api("POST", f"/repos/{repo}/pulls", token, {
            "title": issue["title"], "head": branch, "base": default_branch(repo, token),
            "body": f"Closes #{number}\n\nOpened by the factory agent.",
        })
        comment(repo, number, token, f"Pull request: {pr['html_url']}")
    print(pr["html_url"])

    # The retro is best effort: the PR is already up, so a failed retro is logged, not fatal.
    try:
        retro(repo, model, number, workdir, rev_parse(git), token, agent_env)
    except Exception as e:
        print(f"finances-agent: retro failed: {type(e).__name__}: {e}", file=sys.stderr)
    return 0


def retro(repo, model, number, workdir, sha, token, agent_env):
    out_path = fresh_path(f"issue-{number}.retro.md")
    run(["opencode", "run", "--continue", "--model", model, retro_prompt(repo, number, out_path)],
        cwd=workdir, env=agent_env, timeout=RETRO_TIMEOUT_S)
    with open(out_path) as f:
        text = f.read().strip()
    if not text:
        raise RuntimeError("the retro wrote nothing")
    post_retro(repo, number, sha, text, token)


def cmd_review_run(repo, model, number):
    token, openrouter_key = read_secrets()
    issue = api("GET", f"/repos/{repo}/issues/{number}", token)
    branch = branch_name(number)
    pr = existing_pr(repo, branch, token)
    if pr is None:
        raise RuntimeError(f"no open pull request for {branch}")
    base = default_branch(repo, token)
    workdir = fresh_path(f"review-{number}")
    spec_path = fresh_path(f"review-{number}.spec.md")
    out_path = fresh_path(f"review-{number}.json")

    git_env = {**os.environ, **git_auth_env(token)}
    run(["git", "clone", f"https://github.com/{repo}.git", workdir], env=git_env)
    git = ["git", "-C", workdir]
    run([*git, "fetch", "origin", branch], env=git_env)
    run([*git, "checkout", "-B", branch, f"origin/{branch}"])
    sha = rev_parse(git)
    with open(spec_path, "w") as f:
        f.write(f"# {issue['title']}\n\n{(issue.get('body') or '')[:BODY_LIMIT_CHARS]}\n")

    agent_env = {**os.environ, "OPENROUTER_API_KEY": openrouter_key}
    run(["opencode", "run", "--model", model, review_prompt(base, spec_path, out_path)],
        cwd=workdir, env=agent_env, timeout=REVIEW_TIMEOUT_S)
    with open(out_path) as f:
        summary, findings = parse_review(f.read())

    reviews = paged(f"/repos/{repo}/pulls/{pr['number']}/reviews", token)
    bad = blocking(findings)
    if not starts_with(reviews, review_marker(sha)):  # a repeat of this commit's review posts nothing
        post_review(repo, pr["number"], sha, token, render_review(sha, summary, findings), not bad)
    if not bad:
        return REVIEW_CLEAN
    return REVIEW_EXHAUSTED if review_rounds(reviews, sha) >= MAX_REVIEW_ROUNDS else REVIEW_FINDINGS


def default_branch(repo, token):
    return api("GET", f"/repos/{repo}", token)["default_branch"]


def load_config():
    with open(CONFIG_FILE) as f:
        c = json.load(f)
    return c["repo"], c["model"]


def main(argv):
    repo, model = load_config()
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
        raise ValueError(f"config repo must be owner/name, got {repo!r}")
    if argv[1:2] == ["poll"] and len(argv) == 2:
        return cmd_poll(repo)
    if argv[1:2] == ["work"] and len(argv) == 3:
        return cmd_work(repo, parse_issue_number(argv[2]))
    if argv[1:2] == ["review"] and len(argv) == 3:
        return cmd_review(repo, parse_issue_number(argv[2]))
    if argv[1:2] == ["run"] and len(argv) == 3:
        return cmd_run(repo, model, parse_issue_number(argv[2]))
    if argv[1:2] == ["review-run"] and len(argv) == 3:
        return cmd_review_run(repo, model, parse_issue_number(argv[2]))
    sys.exit(__doc__)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # fail closed: a nonzero exit, never a half-claimed success. No tokens in messages.
        sys.exit(f"finances-agent: {type(e).__name__}: {e}")
