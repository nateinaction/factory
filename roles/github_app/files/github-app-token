#!/usr/bin/env python3
"""Mint GitHub App installation tokens, one App per agent role.

`token` prints a fresh, uncached token of an App, limited to one repository and
carrying the permissions the App was granted; with --read-only it is restricted
to the reads the agent role's App holds (Contents, Issues, Pull requests and Metadata,
less any the App lacks): what the model inside a run gets as GH_TOKEN, so it can read
the issue and the pull request but never write. GitHub refuses a token that asks for
more than its App holds, so a role not listed here gets no read-only token.

`repositories` prints OWNER/NAME for every repository the App is installed on. A listing
longer than the tool reads, or an App installed on more installations than it lists, is a
failure: it prints nothing rather than part of the answer.

Config dir (default /etc/github-app, override with GITHUB_APP_DIR) holds one
directory per App, named for its agent role:
  <A>/app-id, <A>/private-key.pem
An App never uses another App's directory: a missing credential, an App that
is not installed on the repository, or any other failure exits non-zero and
prints nothing on stdout.
"""
import argparse
import base64
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONF = os.environ.get("GITHUB_APP_DIR", "/etc/github-app")
API = os.environ.get("GITHUB_API_URL", "https://api.github.com")
APP_RE = re.compile(r"^[a-z]{1,20}$")
REPO_RE = re.compile(r"^([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$")
PAGE_SIZE = 100
MAX_PAGES = 10
MAX_INSTALLATIONS = 50
# The model reads what its agent role's App holds and never writes. These are the reads of the
# spec's permission table: Planner has no Pull requests, Curator no Contents or Pull requests.
READ_ONLY = {
    "planner": ("contents", "issues", "metadata"),
    "researcher": ("contents", "issues", "metadata"),
    "implementer": ("contents", "issues", "metadata", "pull_requests"),
    "reviewer": ("contents", "issues", "metadata", "pull_requests"),
    "curator": ("issues", "metadata"),
}


def read_only_permissions(app):
    """The read-only permissions an App's token may ask for; an unlisted role fails closed."""
    if app not in READ_ONLY:
        raise ValueError(f"no read-only permissions are set for agent role {app!r}")
    return {name: "read" for name in READ_ONLY[app]}


class Once(argparse.Action):
    """Store a value flag, refusing a repeat instead of letting the last one win."""

    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest) is not None:
            raise argparse.ArgumentError(self, f"{option_string} given more than once")
        setattr(namespace, self.dest, values)


class OnceSwitch(argparse.Action):
    """Set a switch, refusing a repeat for the same reason as Once."""

    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, const=True, default=False, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest):
            raise argparse.ArgumentError(self, f"{option_string} given more than once")
        setattr(namespace, self.dest, self.const)


def build_parser():
    """The command line; argparse owns help, missing flags and flags a command does not take."""
    p = argparse.ArgumentParser(
        prog="github-app-token", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter, allow_abbrev=False,
    )
    cmds = p.add_subparsers(dest="command", required=True, metavar="COMMAND")
    token = cmds.add_parser(
        "token", help="print a token for one repository", allow_abbrev=False,
        description="Print a fresh, uncached token of an App, limited to one repository.",
    )
    token.add_argument("--app", action=Once, required=True, metavar="A",
                       help="the agent role whose App mints the token")
    token.add_argument("--repo", action=Once, required=True, metavar="OWNER/NAME",
                       help="the only repository the token may touch")
    token.add_argument("--read-only", action=OnceSwitch,
                       help="restrict the token to the reads the agent role's App holds")
    repositories = cmds.add_parser(
        "repositories", help="list where the App is installed", allow_abbrev=False,
        description="Print OWNER/NAME for every repository an App is installed on.",
    )
    repositories.add_argument("--app", action=Once, required=True, metavar="A",
                              help="the agent role whose App is listed")
    return p


def b64(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def app_dir(app):
    if not APP_RE.match(app):
        raise ValueError(f"--app takes an agent role name, got {app!r}")
    return os.path.join(CONF, app)


def jwt(app):
    d = app_dir(app)
    with open(os.path.join(d, "app-id")) as f:
        app_id = f.read().strip()
    now = int(time.time())
    head = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    body = b64(json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode())
    signing_input = f"{head}.{body}".encode()
    sig = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", os.path.join(d, "private-key.pem")],
        input=signing_input, capture_output=True, check=True, timeout=10,
    ).stdout
    return f"{head}.{body}.{b64(sig)}"


def call(method, path, bearer, body=None):
    req = urllib.request.Request(
        API + path, method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {bearer}", "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "github-app-token",
                 **({} if body is None else {"Content-Type": "application/json"})},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def installation_token(app, installation_id, repo_name=None, read_only=False):
    body = {} if repo_name is None else {"repositories": [repo_name]}
    if read_only:
        body["permissions"] = read_only_permissions(app)
    r = call("POST", f"/app/installations/{installation_id}/access_tokens", jwt(app), body or None)
    return r["token"]


def repo_token(app, repo, read_only=False):
    """A one-hour token for a single repository, never cached: a cache file would outlive the hour."""
    m = REPO_RE.match(repo)
    if not m or ".." in repo:
        raise ValueError(f"--repo takes OWNER/NAME, got {repo!r}")
    inst = call("GET", f"/repos/{repo}/installation", jwt(app))
    return installation_token(app, inst["id"], m.group(2), read_only)


def listing(path, bearer, key=None):
    """Every item of a paged listing. A short page ends it; a full last allowed page means
    the listing is longer than this tool reads, so it fails instead of answering with part."""
    items = []
    for page in range(1, MAX_PAGES + 1):
        answer = call("GET", f"{path}?per_page={PAGE_SIZE}&page={page}", bearer)
        batch = answer if key is None else answer[key]
        items.extend(batch)
        if len(batch) < PAGE_SIZE:
            return items
    raise RuntimeError(f"{path} is longer than {MAX_PAGES} pages of {PAGE_SIZE}")


def installed_repositories(app):
    """Every repository the App is installed on, across its installations."""
    installations = listing("/app/installations", jwt(app))
    if len(installations) > MAX_INSTALLATIONS:
        raise RuntimeError(f"{len(installations)} installations are over the {MAX_INSTALLATIONS} listed")
    names = []
    for inst in installations:
        names.extend(installation_repositories(installation_token(app, inst["id"])))
    return names


def installation_repositories(token):
    return [x["full_name"] for x in listing("/installation/repositories", token, "repositories")]


def main(argv):
    args = build_parser().parse_args(argv)
    if args.command == "token":
        print(repo_token(args.app, args.repo, args.read_only))
    else:
        for name in installed_repositories(args.app):
            print(name)


try:
    main(sys.argv[1:])
except urllib.error.HTTPError as e:  # fail closed; GitHub's error body says why and holds no secret
    sys.exit(f"github-app-token: HTTPError {e.code}: {e.read().decode(errors='replace')[:500]}")
except Exception as e:  # fail closed: no credential rather than a wrong one
    sys.exit(f"github-app-token: {type(e).__name__}: {e}")
