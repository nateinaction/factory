#!/usr/bin/env python3
"""Mint GitHub App installation tokens; doubles as a git credential helper.

  github-app-token token          print a valid installation token
  github-app-token token --repo R print a fresh, uncached token limited to repo R
                                  (contents, issues, pull_requests: write)
  github-app-token installation   print the installation id (lookup, not cached)
  github-app-token get            git credential helper (use via credential.helper)

Config dir (default /etc/github-app, override with GITHUB_APP_DIR):
  app-id, installation-id, private-key.pem
Tokens are cached in $XDG_CACHE_HOME/github-app-token.json (0600) until
5 minutes before expiry. Any failure exits non-zero and prints nothing on
stdout, so git is never handed a bad credential.
"""
import base64
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

CONF = os.environ.get("GITHUB_APP_DIR", "/etc/github-app")
CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "github-app-token.json",
)
API = "https://api.github.com"
REFRESH_MARGIN_S = 300
SCOPED_PERMISSIONS = {"contents": "write", "issues": "write", "pull_requests": "write"}


def b64(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def read(name):
    with open(os.path.join(CONF, name)) as f:
        return f.read().strip()


def jwt():
    now = int(time.time())
    head = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    body = b64(json.dumps({"iat": now - 60, "exp": now + 540, "iss": read("app-id")}).encode())
    signing_input = f"{head}.{body}".encode()
    sig = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", os.path.join(CONF, "private-key.pem")],
        input=signing_input, capture_output=True, check=True, timeout=10,
    ).stdout
    return f"{head}.{body}.{b64(sig)}"


def call(method, path, bearer, body=None):
    req = urllib.request.Request(
        API + path, method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {bearer}", "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "github-app-token",
                 **({} if body is None else {"Content-Type": "application/json"})},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def cached():
    try:
        with open(CACHE) as f:
            c = json.load(f)
        if c["expires_at"] - time.time() > REFRESH_MARGIN_S:
            return c["token"]
    except (OSError, ValueError, KeyError):
        pass  # missing or corrupt cache just means we mint a new token
    return None


def token():
    t = cached()
    if t:
        return t
    r = call("POST", f"/app/installations/{read('installation-id')}/access_tokens", jwt())
    exp = time.mktime(time.strptime(r["expires_at"], "%Y-%m-%dT%H:%M:%SZ")) - time.timezone
    os.makedirs(os.path.dirname(CACHE), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(CACHE))
    with os.fdopen(fd, "w") as f:
        json.dump({"token": r["token"], "expires_at": exp}, f)
    os.replace(tmp, CACHE)  # atomic, and mkstemp already created it 0600
    return r["token"]


def scoped_token(repo):
    """A one-hour token for a single repo with only the permissions an agent needs.

    Never cached: the caller wants the full hour, and a cache file would outlive it.
    """
    if "/" in repo or not repo:
        raise ValueError(f"--repo takes a bare repo name, got {repo!r}")
    body = {"repositories": [repo], "permissions": SCOPED_PERMISSIONS}
    r = call("POST", f"/app/installations/{read('installation-id')}/access_tokens", jwt(), body)
    return r["token"]


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "token" and sys.argv[2:3] == ["--repo"] and len(sys.argv) == 4:
        print(scoped_token(sys.argv[3]))
    elif cmd == "token" and len(sys.argv) == 2:
        print(token())
    elif cmd == "installation":
        for i in call("GET", "/app/installations", jwt()):
            print(i["id"], i["account"]["login"], i["repository_selection"])
    elif cmd == "get":
        attrs = dict(l.rstrip("\n").split("=", 1) for l in sys.stdin if "=" in l)
        if attrs.get("host") == "github.com" and attrs.get("protocol") == "https":
            print(f"username=x-access-token\npassword={token()}")
    elif cmd in ("store", "erase"):
        pass  # tokens are minted, never stored by git
    else:
        sys.exit(__doc__)


try:
    main()
except urllib.error.HTTPError as e:  # fail closed; GitHub's error body says why and holds no secret
    sys.exit(f"github-app-token: HTTPError {e.code}: {e.read().decode(errors='replace')[:500]}")
except Exception as e:  # fail closed: no credential rather than a wrong one
    sys.exit(f"github-app-token: {type(e).__name__}: {e}")
