[Unit]
Description=Grafana (foreman telemetry UI, loopback only)
After=network-online.target prometheus.service tempo.service loki.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=grafana
# The config is root-only because it holds the admin password. Grafana runs as a DynamicUser and
# cannot read it, so systemd reads it as root and gives the service a private copy instead.
LoadCredential=grafana.ini:/etc/grafana/grafana.ini
ExecStart=/nix/var/nix/profiles/default/bin/grafana server --config=%d/grafana.ini --homepath=/nix/var/nix/profiles/default/share/grafana
Environment=GOMEMLIMIT={{ (factory_telemetry_memory_max_mib.grafana * 0.8) | int }}MiB
MemoryMax={{ factory_telemetry_memory_max_mib.grafana }}M
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
