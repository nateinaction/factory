# {{ ansible_managed }}
# Prometheus alert rules for the signals that need a human. Thresholds, windows and the cost budget
# are group_vars (factory_alerts_*), never constants here. A per-issue alert names the agent role,
# repository and issue from its metric's labels and links to a search for the role's traces; an
# aggregate alert names the agent role and repository and links to a search for their offending
# traces and their failed issues. The issue is a label on the security-event and reaped-run metrics
# only (see factory_collector_allowed_attributes): a Prometheus rule can template only labels, and
# #132's acceptance criterion requires a per-event alert to name the issue it needs a human to see.
# No metric carries a trace id, so no alert links to one.
{% set role = '{{ $labels.factory_agent_role }}' %}
{% set repo = '{{ $labels.factory_repo }}' %}
{% set issue = '{{ $labels.factory_issue }}' %}
{% set trace_query = '%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C'
  ~ '%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20span.factory.agent_role%20%3D%20%5C%22'
  ~ role ~ '%5C%22%20%26%26%20span.factory.repo%20%3D%20%5C%22' ~ repo ~ '%5C%22%20%7D%22%7D%5D%7D' %}
{% set trace_search = factory_alerts_grafana_url ~ '/explore?left=' ~ trace_query %}
{% set issue_url = 'https://github.com/' ~ repo ~ '/issues/' ~ issue %}
{% set issues = 'https://github.com/' ~ repo ~ '/issues?q=label%3Afactory%3Afailed' %}
groups:
  - name: factory-security
    rules:
      - alert: ForemanEgressNotRoutable
        expr: >-
          sum by (factory_agent_role, factory_repo, factory_issue) (
            increase(factory_security_events_total{
              factory_event="egress_refused", factory_outcome="refused_not_routable"}[{{ factory_alerts_security_window }}])
          ) > 0
        labels:
          severity: critical
        annotations:
          summary: 'The {{ role }} role reached for an address that is not publicly routable in {{ repo }}, issue #{{ issue }}'
          description: >-
            A run whose agent role is {{ role }}, repository is {{ repo }} and issue is #{{ issue }}
            had a request refused because its destination resolves to a non-public address (loopback,
            private, shared, link-local or a metadata endpoint).
          trace: '{{ trace_search }}'
          issue: '{{ issue_url }}'

      - alert: ForemanProxyBadToken
        expr: >-
          sum by (factory_agent_role, factory_repo, factory_issue) (
            increase(factory_security_events_total{
              factory_event=~"egress_refused|key_proxy_refused", factory_outcome="refused_bad_token"}[{{ factory_alerts_security_window }}])
          ) > 0
        labels:
          severity: critical
        annotations:
          summary: 'A request reached a {{ role }} run''s proxy without its run token in {{ repo }}, issue #{{ issue }}'
          description: >-
            A request to the egress or OpenRouter key proxy of a run whose agent role is {{ role }},
            repository is {{ repo }} and issue is #{{ issue }} carried a missing or wrong run token,
            and was refused.
          trace: '{{ trace_search }}'
          issue: '{{ issue_url }}'

      - alert: ForemanOutputFactoryMarker
        expr: >-
          sum by (factory_agent_role, factory_repo, factory_issue) (
            increase(factory_security_events_total{
              factory_event="output_rejected", factory_outcome="factory_marker"}[{{ factory_alerts_security_window }}])
          ) > 0
        labels:
          severity: critical
        annotations:
          summary: 'A {{ role }} output file carried a factory marker in {{ repo }}, issue #{{ issue }}'
          description: >-
            A model output file from a run whose agent role is {{ role }}, repository is {{ repo }}
            and issue is #{{ issue }} carried a factory marker: an attempt to forge a state transition
            or a review. Nothing in the file was applied.
          trace: '{{ trace_search }}'
          issue: '{{ issue_url }}'

  - name: factory-runs
    rules:
      - alert: ForemanAgentRoleFailureRate
        expr: >-
          (
            sum by (factory_agent_role, factory_repo) (
              increase(factory_run_outcomes_total{factory_outcome="failed"}[{{ factory_alerts_failure_rate_window }}])
            )
            /
            sum by (factory_agent_role, factory_repo) (
              increase(factory_run_outcomes_total[{{ factory_alerts_failure_rate_window }}])
            )
          ) > {{ factory_alerts_failure_rate_threshold }}
          and on (factory_agent_role, factory_repo)
          sum by (factory_agent_role, factory_repo) (
            increase(factory_run_outcomes_total[{{ factory_alerts_failure_rate_window }}])
          ) >= {{ factory_alerts_failure_rate_min_runs }}
        labels:
          severity: warning
        annotations:
          summary: 'The {{ role }} role is failing more than its share of runs in {{ repo }}'
          description: >-
            Over the last {{ factory_alerts_failure_rate_window }}, more than
            {{ (factory_alerts_failure_rate_threshold * 100) | round | int }}% of runs by agent role
            {{ role }} in {{ repo }} failed, across at least
            {{ factory_alerts_failure_rate_min_runs }} runs. The trace search lists those runs, and
            each trace names its issue; the issue list names the failed issues.
          trace: '{{ trace_search }}'
          issue: '{{ issues }}'

      - alert: ForemanDailyModelCost
        expr: >-
          sum by (factory_agent_role, factory_repo) (
            increase(factory_run_cost_total[{{ factory_alerts_cost_window }}])
          ) > {{ factory_alerts_daily_cost_budget_usd }}
        labels:
          severity: warning
        annotations:
          summary: 'The {{ role }} role spent past the daily model budget in {{ repo }}'
          description: >-
            Over the last {{ factory_alerts_cost_window }}, model calls by agent role {{ role }} in
            {{ repo }} cost more than the daily budget of
            ${{ factory_alerts_daily_cost_budget_usd }}. The trace search lists the runs, and each
            trace names its issue.
          trace: '{{ trace_search }}'
          issue: '{{ issues }}'

      - alert: ForemanDeadRunReaped
        expr: >-
          sum by (factory_agent_role, factory_repo, factory_issue) (
            increase(factory_runs_reaped_total[{{ factory_alerts_dead_run_window }}])
          ) > 0
        labels:
          severity: warning
        annotations:
          summary: 'A poll reaped a dead {{ role }} run in {{ repo }}, issue #{{ issue }}'
          description: >-
            A poll found a {{ role }} run in {{ repo }} whose running label outlived its deadline
            plus the dead-run margin, and moved issue #{{ issue }} to factory:failed. Nothing retries
            it automatically. The trace search lists the role's recent runs, and the issue is the one
            the poll moved.
          trace: '{{ trace_search }}'
          issue: '{{ issue_url }}'
