# {{ ansible_managed }}
# Receives foreman's OTLP on loopback, keeps only allowlisted attributes, derives run counts and
# durations from spans, and forwards to the telemetry backend once one is named.
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: {{ factory_collector_host }}:{{ factory_collector_grpc_port }}
      http:
        endpoint: {{ factory_collector_host }}:{{ factory_collector_http_port }}
{% if factory_host_health | bool %}
  # The host's own health, scraped on loopback. node_exporter supplies memory and filesystem use;
  # its textfile collector carries the SoC temperature and the firmware's throttling bits, which a
  # timer on the host writes. Keeping only the named families bounds cardinality and traffic.
  prometheus/host_health:
    config:
      scrape_configs:
        - job_name: host_health
          scrape_interval: {{ factory_host_health_scrape_interval }}
          static_configs:
            - targets: ["{{ factory_host_health_host }}:{{ factory_host_health_port }}"]
          metric_relabel_configs:
            - action: keep
              source_labels: [__name__]
              regex: "{{ factory_host_health_metrics | join('|') }}"
{% endif %}

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: {{ factory_collector_memory_limit_mib }}
  # Every metric names the host that produced it, so the dashboard joins a run's duration to that
  # host's health. The inventory name is the OS hostname base sets, which a run's span also carries.
  transform/host:
    error_mode: ignore
    metric_statements:
      - context: resource
        statements:
          - set(attributes["host.name"], "{{ inventory_hostname }}")
  # Anything not in allowed_keys is redacted, so a new attribute is dropped until it is added to
  # factory_collector_allowed_attributes. summary: info logs which keys were dropped, never values.
  redaction:
    allow_all_keys: false
    allowed_keys:
{% for key in factory_collector_allowed_attributes %}
      - {{ key }}
{% endfor %}
    summary: info
  batch:
    send_batch_size: {{ factory_collector_batch_size }}
    send_batch_max_size: {{ factory_collector_batch_size }}
    timeout: 5s

connectors:
  # Run counts and duration histograms come from spans, so a short-lived foreman process needs no
  # scrape endpoint. Its dimensions are only what the allowlist already admits.
  spanmetrics:
    dimensions:
      - name: factory.agent_role
      - name: factory.outcome
    # Lets Grafana jump from a metric to the trace behind it.
    exemplars:
      enabled: true

exporters:
  nop: {}
{% if factory_collector_backend_host | length > 0 %}
  # Traces, metrics and diagnostics each go to their own backend port (tempo, prometheus, loki).
  # Each buffers locally, within a fixed size, while the backend is unreachable. The file storage
  # keeps the buffer across a collector restart.
  otlp_grpc/traces:
    endpoint: {{ factory_collector_backend_host }}:{{ factory_telemetry_tempo_otlp_port }}
    tls:
      insecure: true # the tailnet encrypts
    sending_queue:
      enabled: true
      queue_size: {{ factory_collector_queue_size }}
      storage: file_storage/queue
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0s
  otlp_http/metrics:
    endpoint: http://{{ factory_collector_backend_host }}:{{ factory_telemetry_prometheus_port }}/api/v1/otlp
    sending_queue:
      enabled: true
      queue_size: {{ factory_collector_queue_size }}
      storage: file_storage/queue
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0s
  otlp_http/logs:
    endpoint: http://{{ factory_collector_backend_host }}:{{ factory_telemetry_loki_port }}/otlp
    sending_queue:
      enabled: true
      queue_size: {{ factory_collector_queue_size }}
      storage: file_storage/queue
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0s
{% endif %}

{% if factory_collector_backend_host | length > 0 %}
extensions:
  file_storage/queue:
    directory: /var/lib/otelcol/queue
    # StateDirectory makes /var/lib/otelcol; the queue below it must exist before the collector
    # starts, or it refuses the config and crash-loops.
    create_directory: true

{% endif %}
service:
{% if factory_collector_backend_host | length > 0 %}
  extensions: [file_storage/queue]
{% endif %}
  telemetry:
    metrics:
      level: none # no self-metrics endpoint: the collector serves nothing but OTLP
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, redaction, batch]
      exporters: [spanmetrics, nop{% if factory_collector_backend_host | length > 0 %}, otlp_grpc/traces{% endif %}]
    metrics:
      receivers: [otlp, spanmetrics{% if factory_host_health | bool %}, prometheus/host_health{% endif %}]
      processors: [memory_limiter, transform/host, redaction, batch]
      exporters: [nop{% if factory_collector_backend_host | length > 0 %}, otlp_http/metrics{% endif %}]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, redaction, batch]
      exporters: [nop{% if factory_collector_backend_host | length > 0 %}, otlp_http/logs{% endif %}]
